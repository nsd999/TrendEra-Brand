# Public browser-safe settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_MODE=coming-soon
NEXT_PUBLIC_WHATSAPP_NUMBER=916303849852
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets; NEVER use NEXT_PUBLIC_ for these values
SUPABASE_SERVICE_ROLE_KEY=

# Qikink Custom API: use sandbox credentials first.
QIKINK_SANDBOX_MODE=true
QIKINK_CLIENT_ID=
QIKINK_SANDBOX_SECRET=
# Set these only after Qikink approves live API access:
QIKINK_CLIENT_SECRET=
QIKINK_LIVE_ORDERS_ENABLED=false
# Optional: separate strong random token for the admin-only live order-list API route.
QIKINK_ADMIN_API_TOKEN=

# Razorpay online payments; configure keys and webhook secret in Vercel server-side env.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Contact form delivery
