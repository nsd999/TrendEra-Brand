# Public browser-safe settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional comma-separated checkout origins, including temporary Vercel aliases not covered by VERCEL_URL.
CHECKOUT_ALLOWED_ORIGINS=
NEXT_PUBLIC_STORE_MODE=coming-soon
NEXT_PUBLIC_WHATSAPP_NUMBER=916303849852
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets; NEVER use NEXT_PUBLIC_ for these values
SUPABASE_SERVICE_ROLE_KEY=

# Qikink Live Open API Configuration
QIKINK_ENVIRONMENT=live
QIKINK_SANDBOX_MODE=false
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
QIKINK_SANDBOX_SECRET=
QIKINK_LIVE_ORDERS_ENABLED=false
# Secret token for admin-only integration dashboard and order lookup
QIKINK_ADMIN_API_TOKEN=

# Cashfree Payments — server-side only; sandbox by default.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Contact form delivery
RESEND_API_KEY=
CONTACT_TO_EMAIL=trendera.brand@gmail.com
CONTACT_FROM_EMAIL=TrendEra Website <onboarding@resend.dev>
